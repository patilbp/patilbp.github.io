---
import BaseLayout from '../../layouts/BaseLayout.astro';
const positions=[
  {
    "company": "Hearst Corporation",
    "brand": "DBA Black Book",
    "role": "Product Analytics Engineer",
    "dates": "Oct 2024 – Present",
    "location": "Massachusetts, USA",
    "domain": "Automotive intelligence · Product analytics",
    "highlights": [
      "50% less manual processing",
      "46% lower infrastructure cost",
      "40% higher product adoption"
    ],
    "bullets": [
      "Scaled AI-driven automation and Spark-based distributed pipelines for large-scale vehicle data ingestion, cutting manual processing by 50% and accelerating pricing-model refresh cycles by 35%.",
      "Migrated retail-listings data infrastructure to a cloud Databricks Lakehouse, reducing infrastructure costs by 46% and processing times by 83%.",
      "Implemented production Databricks Lakehouse architecture for vehicle analytics, cutting data-processing latency by 60% and improving analytics query performance by 45%, allowing product and analytics teams to generate market insights 2× faster.",
      "Developed and launched Visual Analytics as a product offering for residual-value and vehicle-lifecycle insights, increasing adoption of data-driven valuation tools by 40% among internal analysts and dealership clients.",
      "Optimized BI pipelines and infrastructure supporting 10M+ vehicle listing records, generating $39K in operational savings from harvesting and cloud infrastructure optimization."
    ]
  },
  {
    "company": "Celandyne Software Solutions LLC",
    "role": "Data Scientist",
    "dates": "May 2024 – Sep 2024",
    "location": "California, USA",
    "domain": "AI recruitment · NLP",
    "highlights": [
      "40% more efficient candidate processing",
      "1K+ candidate profiles"
    ],
    "bullets": [
      "Engineered Django backend services for an AI recruitment platform, including authentication and résumé storage workflows, improving candidate-processing efficiency by 40% and supporting 1K+ candidate profiles.",
      "Built production-grade NLP and model-inference workflows for automated résumé ingestion and candidate matching with Python and SQL Server, improving search and matching speed by 50% and helping recruiters shortlist candidates 35% faster."
    ]
  },
  {
    "company": "Valor Compounding Pharmacy",
    "role": "Data Analyst",
    "dates": "Jun 2022 – Feb 2024",
    "location": "California, USA",
    "domain": "Healthcare · Pharmacy analytics",
    "highlights": [
      "90% less reporting time",
      "50+ prescription products"
    ],
    "bullets": [
      "Automated PySpark pipelines processing millions of prescription records, reducing reporting time by 90% and enabling real-time analytics for 50+ prescription products.",
      "Built Python forecasting models using feature engineering and ARIMA, alongside Snowflake ETL pipelines, improving demand-planning accuracy by approximately 25% and reducing manual reporting by 60% for 50+ pharmacists and healthcare staff."
    ]
  },
  {
    "company": "Saviant Consulting",
    "role": "Solution Engineer",
    "dates": "Apr 2019 – Jul 2021",
    "location": "Pune, Maharashtra, India",
    "domain": "Pharmaceuticals · Cosmetics · Manufacturing",
    "highlights": [
      "45% faster reporting performance",
      "35% faster client onboarding"
    ],
    "engagements": [
      {
        "client": "Cencora",
        "previous": "earlier Dymaxium Inc.",
        "sector": "Pharmaceuticals",
        "bullets": [
          "Improved SQL queries and BI dashboards for pharmaceutical sales reporting, increasing report performance by 45% and reducing dashboard load time from 114 seconds to 37 seconds.",
          "Established automated Python and SQL Server data pipelines and ARIMA forecasting models for two-year sales predictions, reducing recurring production work by 50% and accelerating client onboarding by 35%."
        ]
      },
      {
        "client": "L’Oréal India Private Ltd",
        "sector": "Cosmetics",
        "bullets": [
          "Analyzed customer sentiment from 25+ surveys and review platforms using Python, surfacing product quality and usability insights associated with a 20% reduction in failure and complaint rates.",
          "Applied data-driven quality and sales insights to product and supply decisions, helping mitigate approximately 15% potential revenue loss and contributing to approximately 5% profit growth across franchise distribution channels."
        ]
      },
      {
        "client": "SKF India Ltd",
        "sector": "Manufacturing",
        "bullets": [
          "Analyzed inventory, production runs, and purchase orders for demand forecasting across 80+ dealers, helping reduce operational losses by $30K through supply–demand optimization.",
          "Introduced structured data collection and reporting to track dealer demand and inventory performance, cutting manual reporting by 40% and improving supply-chain decision-making."
        ]
      }
    ]
  },
  {
    "company": "Technomatic Services Pvt. Ltd.",
    "role": "Technology Analyst",
    "dates": "Aug 2017 – Apr 2019",
    "location": "Pune, Maharashtra, India",
    "domain": "Petrochemicals · Industrial analytics",
    "highlights": [
      "25% better reporting accuracy",
      "Overtime reduced from 24% to 5%"
    ],
    "engagements": [
      {
        "client": "Honeywell Automation India Ltd",
        "sector": "Petrochemicals",
        "bullets": [
          "Delivered six Salesforce-based reporting automation projects for petrochemical industry clients, improving reporting accuracy by 25% and operational efficiency by 10% through streamlined workflows and analytics dashboards.",
          "Designed SSRS paginated reports with drill-down user analytics and optimized labor-capacity models, reducing overtime from 24% to 5% and supporting data-driven workforce planning."
        ]
      }
