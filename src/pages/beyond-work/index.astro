---
import BaseLayout from '../../layouts/BaseLayout.astro';
const photos=[
  {
    "title": "Last Light",
    "subtitle": "Coast / Evening",
    "src": "https://images.unsplash.com/photo-1644777122204-907ec31b0538?auto=format&fit=crop&w=1900&q=86",
    "url": "https://unsplash.com/photos/a-view-of-a-beach-at-sunset-with-a-pier-in-the-distance-R0XyV52blMs",
    "alt": "Sunset light along the Torrey Pines coastline, photographed by Bhagyashri Patil",
    "shape": "feature",
    "note": "A quieter kind of horizon"
  },
  {
    "title": "Lift",
    "subtitle": "Torrey Pines / California",
    "src": "https://images.unsplash.com/photo-1644777072462-9ac43679036a?auto=format&fit=crop&w=1300&q=85",
    "url": "https://unsplash.com/photos/a-person-flying-a-large-orange-kite-over-a-lush-green-field-8zkR1uW2fgk",
    "alt": "Bright orange paraglider over a green coastal field and ocean",
    "shape": "landscape",
    "note": "The art of taking flight"
  },
  {
    "title": "Symmetry in Gold",
    "subtitle": "Architecture / Perspective",
    "src": "https://images.unsplash.com/photo-1659843376072-a348fbaea990?auto=format&fit=crop&w=1300&q=85",
    "url": "https://unsplash.com/photos/BlgQtOBoZ4k",
    "alt": "Golden geometric architectural ceiling, viewed from below",
    "shape": "landscape",
    "note": "Patterns above us"
  },
  {
    "title": "At the Edge of the Shore",
    "subtitle": "Goa / India",
    "src": "https://images.unsplash.com/photo-1656790821730-ff51eafc3b6c?auto=format&fit=crop&w=1200&q=85",
    "url": "https://unsplash.com/photos/a-dog-lying-on-the-beach-BkcQljbVb8A",
    "alt": "Golden brown dog resting on a coastal ledge at the beach",
    "shape": "landscape",
    "note": "A moment of company"
  },
  {
    "title": "Sunlit Pause",
    "subtitle": "Nature / Wildlife",
    "src": "https://images.unsplash.com/photo-1644776986545-a3b246aa77a0?auto=format&fit=crop&w=1150&q=85",
    "url": "https://unsplash.com/photos/a-small-turtle-sitting-on-top-of-a-rock-jqa0-zlARd4",
    "alt": "Turtle basking on a stone beside the water",
    "shape": "portrait",
    "note": "In its own time"
  },
  {
    "title": "Collected by the Sea",
    "subtitle": "Beach / Details",
    "src": "https://images.unsplash.com/photo-1656790788703-0605e41312c1?auto=format&fit=crop&w=1200&q=85",
    "url": "https://unsplash.com/photos/a-hand-holding-a-group-of-sea-shells-on-a-beach-GZ_uCG_bNns",
    "alt": "Palm holding small beach finds beside the shore in Goa",
    "shape": "landscape",
    "note": "Little things, kept close"
  },
  {
    "title": "Afternoon Comfort",
    "subtitle": "Nature / Animals",
    "src": "https://images.unsplash.com/photo-1733442763792-6c8fa8b4ca96?auto=format&fit=crop&w=1100&q=85",
    "url": "https://unsplash.com/photos/a-cat-laying-on-top-of-a-tree-stump-X8sXLzpvv2I",
    "alt": "Grey-and-white cat relaxing on a tree stump in sunlight",
    "shape": "portrait",
    "note": "A place in the sun"
  },
  {
    "title": "In Bloom",
    "subtitle": "Flowers / Color",
    "src": "https://images.unsplash.com/photo-1660280595918-e180ad83372f?auto=format&fit=crop&w=1200&q=85",
    "url": "https://unsplash.com/photos/a-bunch-of-red-flowers-that-are-blooming-DdnjHjl7dPQ",
    "alt": "Vivid red-pink flowering blossoms in soft focus",
    "shape": "portrait",
    "note": "Color in close-up"
  },
  {
    "title": "Tropical Light",
    "subtitle": "Botanical / Nature",
    "src": "https://images.unsplash.com/photo-1714781280775-2053416dbd68?auto=format&fit=crop&w=1200&q=85",
    "url": "https://unsplash.com/photos/evM-EmEAFrI",
    "alt": "Red hibiscus in warm sun among tropical leaves",
    "shape": "portrait",
    "note": "A final burst of warmth"
  }
];
const volunteerAssets = import.meta.glob('../../assets/volunteering/*.webp', { eager: true, query: '?url', import: 'default' });
const volunteerPhotoUrl = (file) => volunteerAssets[`../../assets/volunteering/${file}`];
---
<BaseLayout title="Beyond Work | Photography by Bhagyashri Patil">
<header class="beyond-hero">
  <div class="beyond-intro"><p class="margin-note">Small moments, kept close.</p><span class="eyebrow">Beyond Work / Photography</span><h1>A different way<br/>of <em>seeing the world.</em></h1>
    <p>Some stories are told in data. Others live in the light, colors, and quiet moments around us. Photography is my way of slowing down and noticing both.</p>
    <div class="actions"><a class="button primary" href="/curiosity-journal/">Open my curiosity journal ↗</a><a class="button secondary" href="/">Back to About →</a></div>
  </div>
  <div class="intro-aside"><span>EST. BY CURIOSITY</span><p>Places.<br/>Perspectives.<br/>Small wonders.</p><span>SELECTED FRAMES / 01—09</span></div>
</header>
<section class="gallery" aria-labelledby="gallery-title">
<div class="gallery-head"><div><span class="eyebrow">01 / A curated collection</span><h2 id="gallery-title">Through my lens.</h2></div><p>Nine favorite moments—from open skies and architecture to animals, textures, and the details in between.</p></div>
<div class="photo-collage">
  <div class="collage-left">
    {[photos[0],photos[5]].map((photo,i)=><figure class="collage-photo">
      <a href={photo.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${photo.title} on Unsplash`} class="collage-link">
        <img src={photo.src} alt={photo.alt} loading={i===0?'eager':'lazy'} decoding="async" />
      </a>
      <figcaption>{photo.title}</figcaption>
    </figure>)}
  </div>
  <div class="collage-right">
    {[[photos[1],photos[3],photos[7]],[photos[2],photos.find(photo => photo.title === 'Tropical Light')],[photos[6],photos.find(photo => photo.title === 'Sunlit Pause')]].map((column,i)=><div class="collage-column">
      {column.map(photo=><figure class="collage-photo">
        <a href={photo.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${photo.title} on Unsplash`} class="collage-link">
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </a>
        <figcaption>{photo.title}</figcaption>
      </figure>)}
    </div>)}
  </div>
</div>
<div class="gallery-cta"><a class="button primary" href="https://unsplash.com/@p_bhagyashri" target="_blank" rel="noopener noreferrer">My photography on Unsplash ↗</a></div>
</section>

<section class="section community" id="community" aria-labelledby="community-heading">
  <div class="section-row">
    <span class="eyebrow">02 / Community</span>
    <div>
      <h2 id="community-heading">A little time, given back.</h2>
      <p>I'm grateful for opportunities to volunteer with local communities. A few moments from causes and events I've been part of over the years.</p>
    </div>
  </div>
  <div class="community-gallery">
    {[
      {file:'thanksgiving-team-2026.webp',alt:'Volunteers together at the Thanksgiving food giveaway',title:"Thanksgiving Food Giveaway",detail:'Gwinnett County · 2026'},
      {file:'paint-gwinnett-pink-2026.webp',alt:'Participants at the Paint Gwinnett Pink 5K',title:'Paint Gwinnett Pink 5K',detail:'Northside Hospital · 2026'},
      {file:'helping-mamas-2025.webp',alt:'Volunteers sorting supplies at Helping Mamas',title:'Helping Mamas',detail:'Community volunteering · 2025'},
      {file:'school-supply-drive-2025.webp',alt:'Volunteers with donated backpacks and school supplies',title:'School Supply Drive',detail:'Cobb County · 2025'},
      {file:'junior-achievement-2025.webp',alt:'Volunteers at the Junior Achievement Discovery Center',title:'Junior Achievement',detail:'Gwinnett · 2025'},
      {file:'helping-mamas-2024.webp',alt:'Volunteer group inside the Helping Mamas warehouse',title:'Helping Mamas',detail:'Community volunteering · 2024'}
    ].map(item=><figure class="community-moment">
      {volunteerPhotoUrl(item.file) && <img src={volunteerPhotoUrl(item.file)} alt={item.alt} loading="lazy" decoding="async" />}
      <figcaption><span class="community-title">{item.title}</span><span class="community-detail">{item.detail}</span></figcaption>
    </figure>)}
  </div>
  <p class="community-note">Earlier: organized a Line Tracer robotics competition at Sinhgad Institute of Technology &amp; Science (2013).</p>
</section>
<section class="section"><div class="section-row"><span class="eyebrow">03 / A little more about me</span><div><h2>Curiosity doesn't end at the desk.</h2><p>Whether I'm exploring a new place or spotting an interesting composition close to home, photography gives me a reason to notice things I might otherwise miss. It's one of the personal interests that makes life richer outside work.</p><div class="actions"><a class="button primary" href="https://unsplash.com/@p_bhagyashri" target="_blank" rel="noopener noreferrer">Explore my Unsplash collection ↗</a><a class="button secondary" href="/contact/">Let's connect →</a></div></div></div></section>
</BaseLayout>
<style>
.beyond-hero{min-height:unset;padding:var(--page-intro-top) 0 var(--page-intro-bottom);display:grid;grid-template-columns:minmax(0,1.35fr) minmax(230px,.5fr);align-items:start;gap:clamp(45px,8vw,130px)}
.beyond-hero h1{font-size:var(--page-h1-size);line-height:1.16;margin:16px 0 25px}.beyond-hero em{font-style:normal;color:#30353b}.beyond-hero p{max-width:710px}.beyond-intro{max-width:920px}.intro-aside{align-self:center}
.intro-aside{border-left:1px solid #d8e2ef;padding-left:28px}.intro-aside>span{font-size:.66rem;font-weight:800;letter-spacing:.13em;color:#8190a6}.intro-aside p{font:700 clamp(1.1rem,1.6vw,1.5rem)/1.65 Manrope,sans-serif;color:#253b55;margin:20px 0}
.gallery{border-top:1px solid #e0e8f1;padding:clamp(55px,6vw,86px) 0}.gallery-head{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:35px}.gallery-head h2{margin:13px 0 0}.gallery-head p{max-width:420px;font-size:.98rem;margin:0}
.gallery-cta{display:flex;justify-content:flex-end;margin-top:20px}
@media(max-width:620px){.gallery-cta{justify-content:center}.gallery-cta .button{width:100%;max-width:360px}}
.photo-collage{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2.05fr);gap:10px;align-items:start;max-width:1390px}
.collage-left,.collage-column{display:flex;flex-direction:column;gap:10px;min-width:0}
.collage-right{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;min-width:0}
.collage-photo{margin:0;min-width:0}
.collage-link{display:block;border-radius:9px;overflow:hidden;background:#e8edf4}
.collage-link img{display:block;width:100%;height:auto;object-fit:contain;max-width:100%;transition:filter .2s ease}
.collage-link:hover img{filter:brightness(.94)}
.collage-photo figcaption{display:block;padding:7px 2px 0;color:#52637b;font-size:.79rem;font-weight:700;line-height:1.35}
@media(max-width:930px){.beyond-hero{grid-template-columns:1fr;min-height:unset;gap:45px}.intro-aside{max-width:350px}.photo-collage{grid-template-columns:minmax(0,1fr) minmax(0,1.55fr);gap:8px}.collage-right{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.collage-column{gap:8px}.collage-right .collage-column:nth-child(3){grid-column:1 / -1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:8px}}
@media(max-width:620px){.beyond-hero{padding:var(--page-intro-top) 0 var(--page-intro-bottom)}.gallery-head{display:block}.gallery-head p{margin-top:18px}.photo-collage{grid-template-columns:1fr}.collage-left{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.collage-right{grid-template-columns:repeat(2,minmax(0,1fr))}.collage-photo figcaption{font-size:.73rem;padding-top:5px}}
@media(max-width:370px){.collage-right{grid-template-columns:1fr}.collage-right .collage-column:nth-child(3){grid-column:auto}.collage-left{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.collage-link img{transition:none}}

.community-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(24px,3vw,44px) clamp(15px,2.2vw,30px);margin-top:35px}
.community-moment{margin:0;min-width:0}
.community-moment img{display:block;width:100%;aspect-ratio:1.45;object-fit:cover;border-radius:11px;background:#e7edf5}
.community-moment figcaption{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:12px 1px 0}
.community-title{font-size:.95rem;font-weight:700;color:#263953}
.community-detail{font-size:.81rem;color:#7d8999}
.community-note{font-size:.88rem;color:#7d8999;margin:30px 0 0}
@media(max-width:850px){.community-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.community-gallery{grid-template-columns:1fr}.community-moment img{aspect-ratio:1.65}}
</style>

<style>

.beyond-hero h1{font-size:var(--page-h1-size);font-family:Georgia,serif;font-weight:500;line-height:1.09;letter-spacing:-.05em}
.beyond-hero em{font-style:italic;color:var(--sage)}
.intro-aside{border-left-color:var(--line)}
.intro-aside>span{color:var(--clay)}
.intro-aside p{font:500 clamp(1.35rem,2vw,2rem)/1.5 Georgia,serif;color:var(--sage-deep)}
.gallery{border-top-color:var(--line)}
.gallery-head p{color:#677063}
.collage-link{border-radius:2px;background:var(--paper-deep)}
.collage-photo figcaption{color:#566356;font-family:Georgia,serif;font-style:italic;font-weight:500;font-size:.93rem}
.community-moment img{border-radius:3px;background:var(--paper-deep)}
.community-title{color:var(--sage-deep)}
.community-detail,.community-note{color:#858779}

</style>
