---
import BaseLayout from '../../layouts/BaseLayout.astro';
const photographs=[
  {
    "src": "https://images.unsplash.com/photo-1644777122204-907ec31b0538?auto=format&fit=crop&w=1500&q=85",
    "href": "https://unsplash.com/photos/a-view-of-a-beach-at-sunset-with-a-pier-in-the-distance-R0XyV52blMs",
    "alt": "Coastal landscape at Torrey Pines State Natural Reserve photographed by Bhagyashri Patil",
    "location": "Torrey Pines · California",
    "name": "Where land meets the Pacific",
    "kind": "Landscape"
  },
  {
    "src": "https://images.unsplash.com/photo-1656790788703-0605e41312c1?auto=format&fit=crop&w=1100&q=85",
    "href": "https://unsplash.com/photos/a-hand-holding-a-group-of-sea-shells-on-a-beach-GZ_uCG_bNns",
    "alt": "Seashells held in a hand on Baga Beach in Goa, photographed by Bhagyashri Patil",
    "location": "Baga Beach · Goa",
    "name": "The little things",
    "kind": "Details"
  }
];
---
<BaseLayout title="Beyond Work | Photography by Bhagyashri Patil">
<header class="beyond-hero">
  <div><span class="eyebrow">Beyond Work / A creative perspective</span>
  <h1>A different way<br/>of <em>seeing the world.</em></h1>
  <p>Outside of product thinking and technical problem-solving, I love photography. It invites me to slow down, notice small details, and hold on to moments that would otherwise pass by.</p>
  <div class="actions"><a class="button primary" href="https://unsplash.com/@p_bhagyashri" target="_blank" rel="noopener noreferrer">Explore my Unsplash ↗</a><a class="button secondary" href="/about/">Back to About →</a></div></div>
  <div class="beyond-side"><span class="side-number">01 —</span><p>Curiosity doesn't end when the workday does.</p><span class="side-mark">PHOTOGRAPHY / PLACES / MOMENTS</span></div>
</header>
<section class="section"><div class="gallery-heading"><div><span class="eyebrow">01 / Selected frames</span><h2>Through my lens.</h2></div><p>A small, intentional selection from my photography collection. More favorites will join this page over time.</p></div>
<div class="photo-grid">
{photographs.map((photo,i)=><a class:list={['photo',i===0?'photo-wide':'photo-tall']} href={photo.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${photo.name} on Unsplash`}><div class="photo-frame"><img src={photo.src} alt={photo.alt} loading={i===0?'eager':'lazy'} decoding="async"/><span class="photo-open" aria-hidden="true">View on Unsplash ↗</span></div><div class="photo-meta"><div><span class="eyebrow">{photo.kind} / {String(i+1).padStart(2,'0')}</span><h3>{photo.name}</h3></div><span class="location">{photo.location}</span></div></a>)}
</div></section>
<section class="section"><div class="section-row"><span class="eyebrow">02 / Away from the desk</span><div><h2>Exploration is part of who I am.</h2><p>Photography is one of the ways I recharge and stay curious. I'm especially drawn to nature, places, and the small compositions that often go unnoticed. It's a personal interest rather than a professional credential, and I love having a little corner of this website to share it.</p><div class="actions"><a class="button primary" href="https://unsplash.com/@p_bhagyashri" target="_blank" rel="noopener noreferrer">See the full collection ↗</a><a class="button secondary" href="/contact/">Let's connect →</a></div></div></div></section>
</BaseLayout>
<style>
.beyond-hero{min-height:560px;padding:clamp(75px,8vw,130px) 0;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(230px,.45fr);gap:clamp(30px,8vw,120px);align-items:end}
.beyond-hero h1{font-size:clamp(3.15rem,5.8vw,6.6rem);line-height:1.1;margin:25px 0 29px}.beyond-hero h1 em{font-style:normal;color:#4568d7}.beyond-hero p{max-width:700px}
.beyond-side{border-left:1px solid #dce5f0;padding-left:28px;color:#62728a}.side-number{font-family:Manrope,sans-serif;font-size:2.5rem;color:#496bd6;font-weight:800}.beyond-side p{font-family:Manrope,sans-serif;font-size:1.24rem;color:#243a55;font-weight:700;line-height:1.5}.side-mark{font-size:.65rem;letter-spacing:.15em;font-weight:800;color:#8591a4}
.gallery-heading{display:flex;align-items:end;justify-content:space-between;gap:30px}.gallery-heading h2{margin-top:15px}.gallery-heading p{max-width:390px;font-size:.97rem}.photo-grid{display:grid;grid-template-columns:minmax(0,1.32fr) minmax(0,.86fr);gap:clamp(18px,3vw,42px);margin-top:35px}.photo{min-width:0;display:block}.photo-frame{position:relative;overflow:hidden;border-radius:17px;background:#e6ecf7}.photo-wide .photo-frame{aspect-ratio:4/3}.photo-tall .photo-frame{aspect-ratio:3/4}.photo-frame img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s ease}.photo:hover .photo-frame img{transform:scale(1.035)}.photo-open{position:absolute;right:17px;bottom:18px;background:#fffdf5ee;border-radius:100px;font-size:.75rem;font-weight:800;padding:11px 15px}.photo-meta{display:flex;justify-content:space-between;gap:14px;align-items:end;padding-top:20px}.photo-meta h3{margin:10px 0 0}.location{font-size:.82rem;color:#7c899a;text-align:right}
@media(max-width:900px){.beyond-hero{min-height:unset;grid-template-columns:1fr;gap:45px}.beyond-side{max-width:480px}.photo-grid{grid-template-columns:1fr 1fr;gap:20px}.photo-meta{display:block}.location{display:block;text-align:left;margin-top:8px}}
@media(max-width:650px){.beyond-hero{padding:55px 0}.gallery-heading{display:block}.photo-grid{grid-template-columns:1fr}.photo-tall .photo-frame{aspect-ratio:4/3}.photo-meta{display:flex}.location{text-align:right}.beyond-hero h1{font-size:clamp(2.7rem,10vw,4.4rem)}}
@media(prefers-reduced-motion:reduce){.photo-frame img{transition:none}}
</style>
