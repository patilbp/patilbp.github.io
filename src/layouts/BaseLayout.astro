---
const {title='Bhagyashri Patil | Portfolio'}=Astro.props;
const nav=[['Home','/'],['Experience','/experience/'],['Projects','/projects/'],['Research','/research/']];
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f8fafc"><meta name="description" content="Bhagyashri Patil — business intelligence, analytics, data engineering, and applied AI."><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head><body>
<a class="skip" href="#content">Skip to content</a>
<header class="top"><div class="shell navbar"><a class="brand" href="/">Bhagyashri Patil<span>.</span></a><nav aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}<a class="contact" href="https://www.linkedin.com/in/bhagyashripatil/" target="_blank" rel="noopener noreferrer">Let's connect ↗</a></nav></div></header>
<main class="shell" id="content"><slot /></main>
<footer class="foot"><div class="shell foot-inner"><span>© {new Date().getFullYear()} Bhagyashri Patil</span><span>Built with Astro · Made for clarity</span></div></footer>
</body></html>
<style is:global>
:root{font-family:"DM Sans",system-ui,sans-serif;color:#17253c;background:#f8fafc}*{box-sizing:border-box}body{margin:0}html{scroll-behavior:smooth}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #4c6ddc;outline-offset:4px;border-radius:5px}.skip{position:absolute;top:-100px;background:white;padding:12px;z-index:10}.skip:focus{top:0}.shell{width:min(1520px,calc(100% - clamp(40px,8vw,148px)));margin:auto}.top{background:rgba(255,255,255,.9);border-bottom:1px solid #e2e8f0}.navbar{min-height:88px;display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{font-family:Manrope,sans-serif;letter-spacing:-.04em;font-weight:800;font-size:1.15rem;white-space:nowrap}.brand span{color:#4167dc}.navbar nav{display:flex;align-items:center;gap:clamp(15px,2.4vw,40px);flex-wrap:wrap}.navbar nav a{font-size:.93rem;font-weight:600;color:#637186}.navbar nav a:hover,.navbar nav a[aria-current=page]{color:#16243a}.navbar nav .contact{padding:12px 17px;border:1px solid #dce4ee;background:white;color:#17253c;border-radius:99px}.foot{border-top:1px solid #e1e7f0;padding:30px 0;margin-top:30px;color:#738096;font-size:.85rem}.foot-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.05em}h1{font-size:clamp(2.4rem,3.6vw,4.1rem);line-height:1.16;margin:16px 0 25px}h2{font-size:clamp(1.85rem,2.65vw,2.85rem);line-height:1.25;margin:0 0 18px}h3{font-size:1.2rem;margin:0 0 13px}p{font-size:1.04rem;line-height:1.8;color:#59697f}.eyebrow{font-size:.77rem;letter-spacing:.14em;text-transform:uppercase;color:#4667d4;font-weight:800}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;padding:15px 22px;border:1px solid #dce4ee;border-radius:12px;font-weight:800;font-size:.92rem;transition:transform .2s}.button:hover{transform:translateY(-2px)}.primary{background:#17253d;color:white;border-color:#17253d}.secondary{background:white}.section{border-top:1px solid #e0e7f0;padding:clamp(55px,6vw,95px) 0}.section-row{display:grid;grid-template-columns:minmax(160px,.34fr) minmax(0,1fr);gap:clamp(28px,6vw,105px)}.section-row p{max-width:850px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:35px}.card{border:1px solid #e0e6f0;background:white;border-radius:20px;padding:clamp(24px,2.5vw,35px)}.card .eyebrow{display:block;margin-bottom:18px}.card p{font-size:.96rem;margin:0}.page-intro{max-width:920px;padding:85px 0 65px}.content-block{max-width:900px}.content-block ul{font-size:1.04rem;line-height:1.9;color:#59697f}.content-block h3{margin-top:28px}
@media(max-width:950px){.navbar{flex-direction:column;align-items:flex-start;gap:16px;padding:20px 0}.section-row{grid-template-columns:1fr;gap:15px}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.shell{width:calc(100% - 36px)}.navbar nav{gap:15px}.navbar nav a{font-size:.83rem}.cards{grid-template-columns:1fr}.page-intro{padding:55px 0 40px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button{transition:none}}
</style>
