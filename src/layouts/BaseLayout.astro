---
const {title='Bhagyashri Patil | Product Solutions Engineer'}=Astro.props;
const path=Astro.url.pathname;
const noindex=path.startsWith('/legacy-reference');
const nav=[['About','/'],['Experience','/experience/'],['Projects','/projects/'],['Beyond Work','/beyond-work/'],['Curiosity','/curiosity-journal/']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f8f6ef">
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta name="description" content="Bhagyashri Patil is a Product Solutions Engineer in Melrose, Massachusetts, working on data products, analytics platforms, and applied AI.">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="top"><div class="shell navbar">
  <a class="brand" href="/" aria-label="Bhagyashri Patil — home">Bhagyashri Patil<span>.</span></a>
  <nav aria-label="Main navigation">
    {nav.map(([label,url])=><a href={url} aria-current={path===url?'page':undefined}>{label}</a>)}
    <a class="contact" href="/contact/" aria-current={path==='/contact/'?'page':undefined}>Say hello <span aria-hidden="true">↗</span></a>
  </nav>
</div></header>
<main class="shell" id="content"><slot /></main>
<footer class="foot"><div class="shell foot-inner"><span>© {new Date().getFullYear()} Bhagyashri Patil</span><span class="foot-note">Made with care, curiosity &amp; a little color.</span><a href="/contact/">Let's connect ↗</a></div></footer>
</body>
</html>
<style is:global>
:root{
  --page-intro-top:clamp(64px,7vw,108px);--page-intro-bottom:clamp(55px,6vw,86px);
  --page-h1-size:clamp(2.8rem,5.1vw,5.6rem);
  --paper:#f8f6ef;--paper-deep:#f0eee5;--paper-light:#fcfaf5;--ink:#282e29;
  --sage:#4d6656;--sage-deep:#2f3b32;--muted:#657064;--line:#dbd9cf;--clay:#90725b;
  font-family:"DM Sans",system-ui,sans-serif;color:var(--ink);background:var(--paper)
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:115px}
body{margin:0;background:var(--paper);color:var(--ink);overflow-x:hidden}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:3px solid var(--sage);outline-offset:4px;border-radius:3px}
::selection{background:#dbe3d8;color:#233226}
.skip{position:absolute;top:-110px;left:10px;background:#fff;padding:13px 18px;z-index:500}
.skip:focus{top:8px}
.shell{width:min(1520px,calc(100% - clamp(40px,8vw,148px)));margin-inline:auto}
.top{position:sticky;top:0;z-index:100;background:rgba(248,246,239,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px)}
.navbar{min-height:86px;display:flex;justify-content:space-between;align-items:center;gap:24px}
.brand{font:500 1.45rem/1.1 Georgia,"Times New Roman",serif;letter-spacing:-.045em;white-space:nowrap;color:var(--ink)}
.brand span{color:var(--sage)}
.navbar nav{display:flex;align-items:center;gap:clamp(14px,2vw,31px);flex-wrap:wrap}
.navbar nav>a{font-size:.86rem;font-weight:700;color:#687369;padding:6px 0;border-bottom:1px solid transparent;transition:color .2s ease}
.navbar nav>a:not(.contact):hover,.navbar nav>a:not(.contact)[aria-current=page]{color:var(--sage-deep);border-bottom-color:var(--sage)}
.navbar nav .contact{border:1px solid var(--sage-deep);background:var(--sage-deep);color:#fff;padding:11px 16px;border-radius:4px}
.navbar nav .contact:hover,.navbar nav .contact[aria-current=page]{background:var(--sage);border-color:var(--sage);color:#fff}
.foot{border-top:1px solid var(--line);padding:28px 0;margin-top:46px;color:#788075;font-size:.82rem}
.foot-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.foot a{color:var(--sage-deep);font-weight:700;text-decoration:underline;text-underline-offset:4px}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;letter-spacing:-.045em;font-weight:500;color:var(--ink)}
h1{font-size:var(--page-h1-size);line-height:1.09;margin:17px 0 28px}
h2{font-size:clamp(2.05rem,3.1vw,3.65rem);line-height:1.15;margin:0 0 20px}
h3{font-size:clamp(1.25rem,1.55vw,1.6rem);line-height:1.26;margin:0 0 14px}
p{font-size:1.04rem;line-height:1.82;color:#59655a}
.eyebrow{display:inline-block;font-size:.73rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clay);font-weight:700}
.margin-note{font:italic 1.11rem Georgia,serif;color:var(--clay);margin:0 0 18px}
.actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:28px}
.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 20px;border:1px solid #ccd0c5;border-radius:4px;font-weight:700;font-size:.87rem;transition:background .2s ease,transform .2s ease}
.button:hover{transform:translateY(-2px);background:#ebece4}
.button.primary{background:var(--sage-deep);border-color:var(--sage-deep);color:#fff}
.button.primary:hover{background:var(--sage);border-color:var(--sage)}
.button.secondary{background:transparent;color:var(--sage-deep)}
.section{border-top:1px solid var(--line);padding:clamp(55px,6vw,90px) 0}
.section-row{display:grid;grid-template-columns:minmax(160px,.34fr) minmax(0,1fr);gap:clamp(28px,6vw,100px)}
.section-row p{max-width:850px}
.section-row h2{max-width:970px}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:35px}
.card{border:1px solid var(--line);background:var(--paper-light);border-radius:3px;padding:clamp(22px,2.2vw,30px)}
.card .eyebrow{display:block;margin-bottom:17px}
.card p{font-size:.96rem;margin:0}
.page-intro{max-width:1130px;padding:var(--page-intro-top) 0 var(--page-intro-bottom)}
.page-intro h1{max-width:1040px}
.page-intro h1 .accent{color:var(--sage);font-style:italic}
.page-intro>p:not(.margin-note){max-width:800px}
.content-block{max-width:900px}
.content-block ul{font-size:1.04rem;line-height:1.9;color:var(--muted)}
.content-block h3{margin-top:28px}
@media(max-width:1040px){.navbar{min-height:80px;align-items:flex-start;flex-direction:column;justify-content:center;gap:15px;padding:17px 0}.navbar nav{gap:clamp(13px,2vw,24px)}html{scroll-padding-top:145px}}
@media(max-width:950px){.section-row{grid-template-columns:1fr;gap:15px}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){
 :root{--page-h1-size:clamp(2.65rem,10vw,3.6rem);--page-intro-top:58px;--page-intro-bottom:49px}
 html{scroll-padding-top:164px}
 .shell{width:calc(100% - 36px)}
 .navbar nav{column-gap:15px;row-gap:7px}
 .navbar nav>a{font-size:.78rem}
 .navbar nav .contact{padding:8px 11px}
 .cards{grid-template-columns:1fr}
 .page-intro{padding:var(--page-intro-top) 0 var(--page-intro-bottom)}
 .foot-note{display:none}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button,.navbar nav>a{transition:none}}
</style>